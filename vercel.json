{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/tiktok-affiliate-sync",
      "schedule": "30 2 * * *"
    }
  ],
  "functions": {
    "api/sync.js": {
      "maxDuration": 300,
      "includeFiles": "products.json"
    },
    "api/affiliate-click.js": {
      "maxDuration": 10,
      "includeFiles": "products.json"
    },
    "api/affiliate-stats.js": {
      "maxDuration": 10
    },
    "api/affiliate-conversion.js": {
      "maxDuration": 10
    },
    "api/tiktok-affiliate-sync.js": {
      "maxDuration": 60
    },
    "api/admin-product-inspect.js": {
      "maxDuration": 20
    },
    "api/admin-products.js": {
      "maxDuration": 30,
      "includeFiles": "products.json"
    },
    "api/ai-product-content.js": {
      "maxDuration": 60
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|webp|svg|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
